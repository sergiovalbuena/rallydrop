// =============================================================================
// RallyDrop — tennis ball machine rentals, Victoria BC
// Prisma 7 schema (PostgreSQL — Neon or Supabase).
//
// Conventions
// - Money is stored as integer cents (CAD). Never floats.
// - Percentages are stored as basis points (500 = 5.00%).
// - All timestamps are timestamptz (UTC in the DB); the app converts to
//   America/Vancouver with date-fns-tz.
// - No card data is ever stored here: only Stripe IDs.
// - Double-booking is enforced in Postgres by an EXCLUSION constraint on
//   `MachineOccupancy`, which Prisma cannot express natively; it is written
//   by hand at the end of prisma/migrations/*_init/migration.sql.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Settings & content (admin-editable)
// -----------------------------------------------------------------------------

/// Singleton row (id = "default"). Everything the owner can tweak without a deploy.
model Settings {
  id String @id @default("default")

  // Taxes — owner must confirm rates and applicability with their accountant.
  // A small supplier that isn't registered must not charge GST, so both are
  // off by default and can only be switched on with a registration number.
  gstBps    Int     @default(500) // 5%
  pstBps    Int     @default(700) // 7%
  chargeGst Boolean @default(false)
  chargePst Boolean @default(false)
  gstNumber String?
  pstNumber String?

  // Site & business details (blank = hidden on the site)
  siteDomain   String?
  hubAddress   String? // self-serve pick-up point
  instagramUrl String?

  // Insurance & licence (shown on the site only when filled in)
  insuranceProvider           String?
  insurancePolicyNumber       String?
  insuranceCoverageCents      Int?
  businessLicenceNumber       String?
  businessLicenceMunicipality String?

  // RallyDrop Care (damage protection add-on)
  careEnabled    Boolean @default(true)
  careShortCents Int     @default(800) // day & weekend
  careWeekCents  Int     @default(1500)
  careMonthCents Int     @default(2500)
  /// Most a Care customer pays for accidental damage.
  careCapCents   Int     @default(10000)

  /// Long rentals: how the renter's ID is checked at hand-off.
  identityCheck IdentityCheck @default(MANUAL)

  // Booking rules
  bufferMinutes        Int @default(120) // battery charge + cleaning between rentals
  holdMinutes          Int @default(10) // temporary hold while the customer pays
  minLeadTimeHours     Int @default(12) // earliest a booking can start from now
  maxAdvanceDays       Int @default(90)
  /// Rentals of up to this many days get a manual-capture card authorization;
  /// longer ones save the card off-session instead.
  depositAuthMaxDays   Int @default(6)
  /// Authorizations expire (~7 days for online card payments), so for rentals
  /// starting further out than this the card is saved at booking time and the
  /// hold is placed by a cron job this many hours before pickup.
  depositAuthLeadHours Int @default(24)

  // Cancellation policy
  cancelFullRefundHours Int @default(48)
  cancelLateRefundBps   Int @default(5000) // 50% refund inside the window

  // Delivery
  deliveryStartMinute Int     @default(480) // 08:00, minutes from midnight local
  deliveryEndMinute   Int     @default(1260) // 21:00 (Friday-night weekend start)
  /// Where trips are measured from (and where self-serve customers collect).
  deliveryHubLat      Decimal @default(48.4284) @db.Decimal(9, 6) // downtown Victoria
  deliveryHubLng      Decimal @default(-123.3656) @db.Decimal(9, 6)
  /// Paid drop-off / collection, priced per trip by distance from the hub:
  /// [{ "maxKm": 5, "tripCents": 1500, "roundTripCents": 2500 }, ...] (ascending).
  /// Beyond the last zone we don't deliver online.
  deliveryZones       Json    @default("[{\"maxKm\":5,\"tripCents\":1500,\"roundTripCents\":2500},{\"maxKm\":12,\"tripCents\":2500,\"roundTripCents\":4000},{\"maxKm\":20,\"tripCents\":3500,\"roundTripCents\":6000}]")

  // High season (inclusive, "MM-DD", Vancouver dates). Prices switch on the
  // rental's start date; outside it the off-season prices apply.
  seasonStart        String  @default("04-01")
  seasonEnd          String  @default("09-30")
  /// When false, bookings outside the season are refused entirely.
  allowOffSeason     Boolean @default(true)
  /// Month rentals block four weekends: cap how many can start per calendar
  /// month in high season (null = no limit, 0 = not offered in high season).
  highSeasonMonthCap Int?    @default(1)

  // Notifications
  smsEnabled Boolean @default(false) // also requires Twilio env vars

  contactEmail String?
  contactPhone String?

  /// Stripe Tax Rate objects for subscription invoices; recreated whenever
  /// the percentage changes (Stripe tax rates are immutable).
  stripeGstTaxRateId String?
  stripePstTaxRateId String?

  updatedAt DateTime @updatedAt @db.Timestamptz
}

/// Editable copy blocks for the marketing site, per locale. Falls back to the
/// static translation files in /messages when a key is missing here.
model SiteContent {
  id        String   @id @default(cuid())
  key       String // e.g. "home.hero.title"
  locale    String   @default("en")
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([key, locale])
}

// -----------------------------------------------------------------------------
// Catalog: machines, products, add-ons, courts
// -----------------------------------------------------------------------------

enum MachineStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum IdentityCheck {
  MANUAL // admin ticks "ID verified" + licence last 4 at hand-off
  STRIPE_IDENTITY // feature flag, not wired yet
}

enum Sport {
  TENNIS
  PICKLEBALL
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

model Machine {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String // "PONGBOT Aura"
  model         String
  description   String?
  imageUrl      String?
  status        MachineStatus @default(AVAILABLE)
  /// False = listed on the site as "Coming soon" but not bookable yet.
  bookable      Boolean       @default(true)
  /// Hidden machines never appear on the public site (any page).
  isPublic      Boolean       @default(true)
  /// Admin-set colour for the master calendar (hex).
  calendarColor String        @default("#1d4ed8")
  sortOrder     Int           @default(0)

  // Spec sheet
  weightKg     Decimal?     @db.Decimal(5, 2)
  maxSpeedKmh  Int?
  ballCapacity Int?
  batteryHours Decimal?     @db.Decimal(4, 1)
  sports       Sport[]
  levels       SkillLevel[]
  specs        Json? // free-form extra rows: [{ label, value }]

  /// Card hold for rentals up to Settings.depositAuthMaxDays.
  depositCents      Int     @default(40000)
  /// Saved-card deposit for week & month rentals.
  depositLongCents  Int     @default(60000)
  /// What the machine cost (admin payback tracking).
  purchaseCostCents Int?
  /// Comes with the AI coach (camera module): highlighted on the site.
  aiCoach           Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  bookings      Booking[]
  occupancies   MachineOccupancy[]
  groupSessions GroupSession[]
  maintenance   MaintenanceLog[]
  blackouts     Blackout[]
  waitlist      WaitlistSignup[]
}

/// "Notify me" sign-ups for machines that aren't bookable yet. Each row is
/// an express request to be emailed about that machine (CASL), and the
/// count per machine is the owner's demand signal.
model WaitlistSignup {
  id         String    @id @default(cuid())
  machineId  String
  machine    Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  email      String
  /// Where the form was (e.g. "home", "machines").
  source     String?
  /// Exact wording the person agreed to.
  consent    String
  notifiedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@unique([machineId, email])
  @@index([machineId, createdAt])
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  machineId   String
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  performedAt DateTime @db.Timestamptz
  summary     String
  costCents   Int?
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([machineId, performedAt])
}

enum ProductKind {
  DAY
  WEEKEND
  WEEK
  MONTH
  PACKAGE // monthly subscription of N sessions
  GROUP_SESSION
}

model Product {
  id                  String      @id @default(cuid())
  slug                String      @unique // "day", "weekend", "package-basic"...
  kind                ProductKind
  name                String
  description         String?
  /// High-season price (and the only price for non-rental products).
  priceCents          Int
  /// Off-season price for rentals; null = same as priceCents.
  offSeasonPriceCents Int?
  active              Boolean     @default(true)
  sortOrder           Int         @default(0)

  /// Rental length for DAY/WEEKEND/WEEK/MONTH: DAY = 25 h (owner's choice),
  /// WEEKEND = 48 h, WEEK = 168 h, MONTH = 720 h.
  durationHours    Int?
  /// Optional fixed start slots, e.g. WEEKEND: Sat 09:00 or Fri 21:00.
  /// Shape: [{ "weekday": 0-6 (Sun=0), "minute": minutes from local midnight }]
  allowedStarts    Json?
  /// PACKAGE: sessions included per billing month and length of each.
  sessionsPerMonth Int?
  sessionMinutes   Int?
  /// GROUP_SESSION defaults (each session can override).
  groupCapacity    Int?

  /// Stripe Product/Price (recurring for PACKAGE). Re-created when price changes.
  stripeProductId String?
  stripePriceId   String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  bookings      Booking[]
  subscriptions Subscription[]
}

enum AddOnKind {
  /// Balls are included in every rental; this is the optional extra bucket.
  EXTRA_BALLS
}

model AddOn {
  id          String    @id @default(cuid())
  kind        AddOnKind @unique
  name        String
  description String?
  priceCents  Int
  active      Boolean   @default(true)

  bookingAddOns BookingAddOn[]
}

/// Public courts the customer can pick for delivery.
model Court {
  id        String  @id @default(cuid())
  name      String // "Beacon Hill Park courts"
  address   String
  lat       Decimal @db.Decimal(9, 6)
  lng       Decimal @db.Decimal(9, 6)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  bookings      Booking[]
  groupSessions GroupSession[]
}

// -----------------------------------------------------------------------------
// Availability
// -----------------------------------------------------------------------------

enum BlackoutReason {
  WEATHER
  MAINTENANCE
  HOLIDAY
  OTHER
}

/// Admin-blocked period. machineId null = all machines. Each blackout also
/// writes one MachineOccupancy row per affected machine so the exclusion
/// constraint enforces it.
model Blackout {
  id        String         @id @default(cuid())
  machineId String?
  machine   Machine?       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  startsAt  DateTime       @db.Timestamptz
  endsAt    DateTime       @db.Timestamptz
  reason    BlackoutReason @default(OTHER)
  note      String?
  createdAt DateTime       @default(now()) @db.Timestamptz

  occupancies MachineOccupancy[]

  @@index([startsAt, endsAt])
}

enum OccupancySource {
  BOOKING
  GROUP_SESSION
  BLACKOUT
}

/// The single source of truth for "is this machine busy?".
/// For bookings the block is [startsAt, endsAt + buffer): the buffer after each
/// rental (charging, cleaning) means two rentals are always >= buffer apart.
/// Postgres EXCLUDE USING gist (machine_id WITH =, tstzrange(...) WITH &&)
/// WHERE (active) makes overlapping active rows impossible.
model MachineOccupancy {
  id            String          @id @default(cuid())
  machineId     String
  machine       Machine         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  source        OccupancySource
  blockStart    DateTime        @db.Timestamptz
  blockEnd      DateTime        @db.Timestamptz
  /// False once the owning booking is cancelled/expired; inactive rows are
  /// ignored by the constraint and kept for history.
  active        Boolean         @default(true)
  /// Pending-payment holds expire; the booking service deactivates expired
  /// holds inside the same transaction before inserting a new row.
  holdExpiresAt DateTime?       @db.Timestamptz

  bookingId      String?       @unique
  booking        Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  groupSessionId String?       @unique
  groupSession   GroupSession? @relation(fields: [groupSessionId], references: [id], onDelete: Cascade)
  blackoutId     String?
  blackout       Blackout?     @relation(fields: [blackoutId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([machineId, blockStart, blockEnd])
}

// -----------------------------------------------------------------------------
// Customers (no password) & portal auth
// -----------------------------------------------------------------------------

model Customer {
  id         String      @id @default(cuid())
  name       String
  /// At least one of email/phone is required (CHECK constraint in SQL).
  email      String?     @unique // stored lower-cased
  phone      String?     @unique // stored E.164
  skillLevel SkillLevel?

  stripeCustomerId String? @unique

  trusted       Boolean @default(false) // e.g. could waive deposit in future
  blocked       Boolean @default(false)
  internalNotes String?

  marketingOptIn Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  bookings      Booking[]
  subscriptions Subscription[]
  enrollments   GroupEnrollment[]
  acceptances   WaiverAcceptance[]
  otpCodes      CustomerOtp[]
  sessions      CustomerSession[]
}

enum OtpChannel {
  EMAIL
  SMS
}

/// One-time code or magic link token. Only a hash is stored.
model CustomerOtp {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    OtpChannel
  codeHash   String
  expiresAt  DateTime   @db.Timestamptz
  attempts   Int        @default(0)
  consumedAt DateTime?  @db.Timestamptz
  createdAt  DateTime   @default(now()) @db.Timestamptz

  @@index([customerId, createdAt])
}

/// Portal session (httpOnly cookie holds the raw token; DB holds its hash).
model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// Bookings
// -----------------------------------------------------------------------------

enum BookingStatus {
  PENDING_PAYMENT // 10-minute hold while paying
  CONFIRMED
  CHECKED_OUT // machine is out
  RETURNED_OK // => deposit released automatically
  RETURNED_DAMAGED // => admin decides capture amount (note required)
  COMPLETED
  CANCELLED
  EXPIRED // hold timed out
  NO_SHOW
}

enum BookingChannel {
  ONLINE
  ADMIN // phone booking entered by the owner
}

/// Where we meet the machine. PICKUP = self-serve: the customer collects and
/// returns it at the hub, so neither trip below is ours.
enum FulfillmentMethod {
  PICKUP
  DELIVERY_COURT
  DELIVERY_ADDRESS
}

model Booking {
  id      String         @id @default(cuid())
  /// Human-friendly code shown to the customer, e.g. "RLY-7K3Q9".
  code    String         @unique
  status  BookingStatus  @default(PENDING_PAYMENT)
  channel BookingChannel @default(ONLINE)

  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  machineId      String
  machine        Machine       @relation(fields: [machineId], references: [id])
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  /// Set when the booking is a session consumed from a monthly package.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  /// The real rental slot (what the customer sees). Buffer lives on the occupancy.
  startsAt DateTime @db.Timestamptz
  endsAt   DateTime @db.Timestamptz

  fulfillment      FulfillmentMethod @default(PICKUP)
  courtId          String?
  court            Court?            @relation(fields: [courtId], references: [id])
  deliveryAddress  String?
  deliveryLat      Decimal?          @db.Decimal(9, 6)
  deliveryLng      Decimal?          @db.Decimal(9, 6)
  /// Paid trips we make: bring it at the start / come back for it at the end.
  dropoff          Boolean           @default(false)
  collection       Boolean           @default(false)
  /// 1-based zone and distance from the hub when either trip is ours.
  deliveryZone     Int?
  deliveryKm       Decimal?          @db.Decimal(5, 2)
  /// Snapshot of what the trips cost (part of subtotalCents).
  deliveryFeeCents Int               @default(0)
  /// RallyDrop Care bought for this rental (snapshot of its price).
  care             Boolean           @default(false)
  careCents        Int               @default(0)
  /// The off-season price applied (by start date).
  offSeason        Boolean           @default(false)
  customerNotes    String?

  // Price snapshot at booking time (cents). Product price changes never
  // alter existing bookings. subtotalCents is after the promo discount.
  subtotalCents Int
  discountCents Int        @default(0)
  promoCodeId   String?
  promoCode     PromoCode? @relation(fields: [promoCodeId], references: [id])
  gstCents      Int
  pstCents      Int
  totalCents    Int
  gstBps        Int
  pstBps        Int
  currency      String     @default("cad")

  termsAcceptedAt DateTime? @db.Timestamptz
  termsVersion    String?

  cancelledAt    DateTime? @db.Timestamptz
  cancelReason   String?
  reminderSentAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  addOns      BookingAddOn[]
  acceptances WaiverAcceptance[]
  occupancy   MachineOccupancy?
  deposit     Deposit?
  payments    Payment[]
  inspections Inspection[]
  events      BookingEvent[]

  @@index([status, startsAt])
  @@index([machineId, startsAt])
  @@index([customerId])
}

model BookingAddOn {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId    String
  addOn      AddOn   @relation(fields: [addOnId], references: [id])
  quantity   Int     @default(1)
  /// Snapshot; 0 when delivery falls inside the free zone.
  priceCents Int

  @@unique([bookingId, addOnId])
}

/// Audit trail: status changes, reschedules, admin actions, emails sent.
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String // "status_changed", "rescheduled", "deposit_released"...
  actor     String // "customer", "system", "admin:<userId>", "stripe"
  data      Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([bookingId, createdAt])
}

enum InspectionKind {
  CHECK_OUT
  CHECK_IN
}

enum MachineCondition {
  EXCELLENT
  GOOD
  MINOR_WEAR
  DAMAGED
}

model Inspection {
  id             String           @id @default(cuid())
  bookingId      String
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind           InspectionKind
  condition      MachineCondition
  batteryPercent Int?
  ballsCount     Int?
  /// Hand-off checklist (each item checked separately).
  machineOk      Boolean?
  spotterOk      Boolean?
  batteryOk      Boolean?
  chargerOk      Boolean?
  /// Long rentals: ID seen at hand-off.
  idVerified     Boolean          @default(false)
  licenceLast4   String?
  notes          String?
  /// Uploaded to Vercel Blob / Supabase Storage; URLs only.
  photoUrls      String[]
  performedById  String?
  performedBy    User?            @relation(fields: [performedById], references: [id])
  performedAt    DateTime         @default(now()) @db.Timestamptz

  @@unique([bookingId, kind])
}

// -----------------------------------------------------------------------------
// Payments & deposits (Stripe)
// -----------------------------------------------------------------------------

enum DepositStrategy {
  /// <= depositAuthMaxDays: PaymentIntent with capture_method=manual.
  AUTH_HOLD
  /// Longer rentals: card saved (setup_future_usage=off_session); charged
  /// later only if there is damage.
  SAVED_CARD
}

enum DepositStatus {
  PENDING // waiting for card / scheduled auth
  CARD_SAVED // SAVED_CARD strategy, nothing charged
  HELD // authorization active
  RELEASED // authorization cancelled / nothing charged
  CAPTURED // fully captured or charged
  PARTIALLY_CAPTURED
  FAILED // auth or off-session charge failed — admin follow-up
  WAIVED
}

model Deposit {
  id        String          @id @default(cuid())
  bookingId String          @unique
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  strategy  DepositStrategy
  status    DepositStatus   @default(PENDING)

  amountCents   Int // snapshot of machine.depositCents
  capturedCents Int            @default(0)
  /// Required whenever capturedCents > 0.
  captureNote   String?
  /// RallyDrop Care exclusion used to charge above the Care cap.
  careExclusion CareExclusion?

  stripePaymentIntentId String?   @unique
  stripePaymentMethodId String?
  /// When the authorization must be placed (scheduled holds) / expires.
  authScheduledFor      DateTime? @db.Timestamptz
  authExpiresAt         DateTime? @db.Timestamptz

  heldAt       DateTime? @db.Timestamptz
  releasedAt   DateTime? @db.Timestamptz
  capturedAt   DateTime? @db.Timestamptz
  releasedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
}

enum PaymentKind {
  RENTAL
  DEPOSIT_CAPTURE
  SUBSCRIPTION_INVOICE
  GROUP_SESSION
  MANUAL // cash/e-transfer recorded by admin
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id     String        @id @default(cuid())
  kind   PaymentKind
  status PaymentStatus @default(PENDING)

  amountCents   Int
  refundedCents Int    @default(0)
  currency      String @default("cad")

  bookingId      String?
  booking        Booking?         @relation(fields: [bookingId], references: [id])
  subscriptionId String?
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id])
  enrollmentId   String?
  enrollment     GroupEnrollment? @relation(fields: [enrollmentId], references: [id])

  stripePaymentIntentId String? @unique
  stripeInvoiceId       String? @unique
  stripeChargeId        String?
  receiptUrl            String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  refunds Refund[]

  @@index([createdAt])
}

model Refund {
  id             String   @id @default(cuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents    Int
  reason         String?
  stripeRefundId String?  @unique
  createdById    String? // admin user id, null = policy/automatic
  createdAt      DateTime @default(now()) @db.Timestamptz
}

/// Webhook idempotency: every processed Stripe event id is recorded once.
model StripeEvent {
  id          String   @id // evt_...
  type        String
  processedAt DateTime @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// Monthly session packages (Stripe subscriptions)
// -----------------------------------------------------------------------------

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model Subscription {
  id         String             @id @default(cuid())
  customerId String
  customer   Customer           @relation(fields: [customerId], references: [id])
  productId  String
  product    Product            @relation(fields: [productId], references: [id])
  status     SubscriptionStatus @default(INCOMPLETE)

  stripeSubscriptionId String @unique

  /// Current Stripe billing period; sessions remaining =
  /// product.sessionsPerMonth - bookings in [periodStart, periodEnd) not cancelled.
  currentPeriodStart DateTime  @db.Timestamptz
  currentPeriodEnd   DateTime  @db.Timestamptz
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  bookings Booking[]
  payments Payment[]
}

// -----------------------------------------------------------------------------
// Coached group sessions
// -----------------------------------------------------------------------------

enum GroupSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model GroupSession {
  id          String             @id @default(cuid())
  title       String
  description String?
  status      GroupSessionStatus @default(SCHEDULED)
  startsAt    DateTime           @db.Timestamptz
  endsAt      DateTime           @db.Timestamptz
  capacity    Int                @default(6)
  priceCents  Int                @default(2000)
  level       SkillLevel?

  courtId   String
  court     Court   @relation(fields: [courtId], references: [id])
  /// The machine used — blocks it via MachineOccupancy.
  machineId String
  machine   Machine @relation(fields: [machineId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  occupancy   MachineOccupancy?
  enrollments GroupEnrollment[]

  @@index([startsAt])
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

model GroupEnrollment {
  id             String           @id @default(cuid())
  groupSessionId String
  groupSession   GroupSession     @relation(fields: [groupSessionId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id])
  status         EnrollmentStatus @default(PENDING_PAYMENT)
  /// Seat holds expire like booking holds; capacity checked under row lock.
  holdExpiresAt  DateTime?        @db.Timestamptz
  createdAt      DateTime         @default(now()) @db.Timestamptz

  payments Payment[]

  @@unique([groupSessionId, customerId])
}

// -----------------------------------------------------------------------------
// Notifications log (idempotent reminders, debugging)
// -----------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  SMS
}

model NotificationLog {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  template   String // "booking_confirmed", "reminder_24h", "receipt", "deposit_released"
  to         String
  /// Dedup key, e.g. "reminder_24h:<bookingId>".
  dedupeKey  String?             @unique
  providerId String?
  error      String?
  createdAt  DateTime            @default(now()) @db.Timestamptz
}

// -----------------------------------------------------------------------------
// Admin auth (Auth.js v5 + @auth/prisma-adapter)
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz
  image         String?
  /// bcrypt/argon2 hash; null when the user only uses magic links.
  passwordHash  String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  accounts    Account[]
  sessions    Session[]
  inspections Inspection[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz

  @@id([identifier, token])
}

// -----------------------------------------------------------------------------
// Promo codes
// -----------------------------------------------------------------------------

enum PromoKind {
  PERCENT
  FIXED
}

/// Discount codes entered right before payment. Applied to the rental +
/// add-ons before taxes. Usage is counted from bookings that went ahead.
model PromoCode {
  id             String        @id @default(cuid())
  /// Stored upper-case; matching is case-insensitive.
  code           String        @unique
  description    String?
  kind           PromoKind
  /// PERCENT: basis points (1500 = 15%).
  percentBps     Int?
  /// FIXED: amount off in cents.
  amountCents    Int?
  active         Boolean       @default(true)
  startsAt       DateTime?     @db.Timestamptz
  endsAt         DateTime?     @db.Timestamptz
  maxRedemptions Int?
  /// Empty = every rental product.
  productKinds   ProductKind[]
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz

  bookings Booking[]
}

// -----------------------------------------------------------------------------
// Legal: versioned documents and click-through acceptance (clickwrap)
// -----------------------------------------------------------------------------

enum LegalKind {
  TERMS
  WAIVER
}

enum CareExclusion {
  THEFT
  LOSS
  RAIN
  GROSS_NEGLIGENCE
}

/// Every published version of the rental terms and the waiver. Never delete
/// rows: acceptances point at the exact text the customer agreed to.
model LegalDocument {
  id          String    @id @default(cuid())
  kind        LegalKind
  version     String // e.g. "2026-10-22"
  title       String
  /// Markdown-ish text (## headings, - lists, **bold**).
  body        String
  /// SHA-256 of `body`, hex.
  sha256      String
  /// Draft = not reviewed by a lawyer yet (badge shown in admin only).
  draft       Boolean   @default(true)
  /// Null until published; the latest published version is the live one.
  publishedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  termsAcceptances  WaiverAcceptance[] @relation("terms")
  waiverAcceptances WaiverAcceptance[] @relation("waiver")

  @@unique([kind, version])
  @@index([kind, publishedAt])
}

/// Proof a customer ticked the boxes: who, which exact texts, when, from where.
model WaiverAcceptance {
  id              String        @id @default(cuid())
  bookingId       String?
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name            String
  contact         String // email or phone from the booking
  termsId         String
  terms           LegalDocument @relation("terms", fields: [termsId], references: [id])
  waiverId        String
  waiver          LegalDocument @relation("waiver", fields: [waiverId], references: [id])
  termsVersion    String
  termsSha256     String
  waiverVersion   String
  waiverSha256    String
  /// Boxes ticked, e.g. ["terms_waiver", "age_19"].
  checkboxes      Json
  /// "checkout" | "accept_link" | "package" | "carried_over"
  method          String
  ip              String?
  userAgent       String?
  acceptedAt      DateTime      @default(now()) @db.Timestamptz
  /// Same instant in America/Vancouver, human readable.
  acceptedAtLocal String

  @@index([bookingId])
  @@index([customerId, acceptedAt])
}

/// Customer reviews shown on the site (only when 2+ are published).
model Review {
  id           String   @id @default(cuid())
  customerName String
  text         String
  rating       Int      @default(5)
  reviewedOn   DateTime @db.Date
  published    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz
}
