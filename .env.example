# -----------------------------------------------------------------------------
# RallyDrop — environment variables
# Copy to `.env` for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

# Public base URL (used in emails, magic links and Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Neon) ---------------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-west-2.aws.neon.tech/rallydrop?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`. Optional locally.
DIRECT_URL="postgresql://user:password@ep-xxxx.us-west-2.aws.neon.tech/rallydrop?sslmode=require"

# --- Admin auth (Auth.js v5) -------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Only needed when running `next start` outside Vercel (Vercel sets it automatically).
AUTH_TRUST_HOST="true"
# Seeded admin account (only used by `npm run db:seed`).
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# --- Customer portal ---------------------------------------------------------
# Secret used to hash one-time codes and session tokens (32+ random chars).
PORTAL_SECRET=""

# --- Stripe (TEST MODE keys only during development) -------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY="re_..."
# Must be a verified domain/sender in Resend.
EMAIL_FROM="RallyDrop <bookings@yourdomain.ca>"
# Where admin alerts (failed deposits, new bookings) are sent.
ADMIN_ALERT_EMAIL="owner@example.com"

# --- SMS (optional, Twilio) --------------------------------------------------
# SMS is only sent when SMS is enabled in admin settings AND these are set.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- File uploads (check-in photos) -----------------------------------------
# Created automatically when you add a Blob store in Vercel.
BLOB_READ_WRITE_TOKEN=""

# --- Cron --------------------------------------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/cron/* routes.
CRON_SECRET=""
